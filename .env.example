# Copy this file to .env and replace the placeholder values before starting Compose.

# PostgreSQL
POSTGRES_DB=autoloc
POSTGRES_USER=autoloc
POSTGRES_PASSWORD=your-local-db-password-here
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Flask application and authentication
APP_ENV=development
SECRET_KEY=your-flask-secret-here
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS: list explicit frontend origins; do not use a wildcard in production.
CORS_ORIGINS=http://localhost:5173

# Stripe: use test credentials locally, never commit real credentials.
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Frontend
VITE_API_URL=http://localhost:5000/api/v1

# Logging
LOG_LEVEL=INFO
